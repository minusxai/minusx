{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR/frontend\" && npx tsx scripts/check-docs-consistency.ts --hook",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
