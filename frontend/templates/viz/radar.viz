{
  "description": "Radar chart: metrics on angular spokes, one closed polygon per value column (values SUM per metric; one shared radial scale — pre-normalize in SQL when metrics use different units)",
  "engine": "vega",
  "bindings": [
    {
      "name": "metric",
      "label": "Metrics",
      "accepts": [
        "nominal"
      ]
    },
    {
      "name": "values",
      "label": "Values",
      "accepts": [
        "quantitative"
      ],
      "multi": true
    }
  ],
  "template": {
    "autosize": {
      "type": "fit",
      "contains": "padding"
    },
    "signals": [
      {
        "name": "radius",
        "update": "min(width, height) / 2 * 0.72"
      }
    ],
    "data": [
      {
        "name": "main"
      },
      {
        "name": "table",
        "source": "main",
        "transform": [
          {
            "type": "fold",
            "fields": "{{values}}",
            "as": [
              "__mx_series",
              "__mx_fold_value"
            ]
          },
          {
            "type": "aggregate",
            "groupby": [
              "{{metric}}",
              "__mx_series"
            ],
            "fields": [
              "__mx_fold_value"
            ],
            "ops": [
              "sum"
            ],
            "as": [
              "__mx_value"
            ]
          }
        ]
      },
      {
        "name": "keys",
        "source": "table",
        "transform": [
          {
            "type": "aggregate",
            "groupby": [
              "{{metric}}"
            ]
          }
        ]
      },
      {
        "name": "rings",
        "transform": [
          {
            "type": "sequence",
            "start": 1,
            "stop": 5,
            "as": "lvl"
          }
        ]
      }
    ],
    "scales": [
      {
        "name": "angular",
        "type": "point",
        "padding": 0,
        "range": {
          "signal": "[-PI/2, 3*PI/2 - 2*PI/max(1, length(data('keys')))]"
        },
        "domain": {
          "data": "table",
          "field": "{{metric}}"
        }
      },
      {
        "name": "radial",
        "type": "linear",
        "range": [
          0,
          {
            "signal": "radius"
          }
        ],
        "zero": true,
        "nice": false,
        "domain": {
          "data": "table",
          "field": "__mx_value"
        }
      },
      {
        "name": "color",
        "type": "ordinal",
        "domain": {
          "data": "table",
          "field": "__mx_series"
        },
        "range": "category"
      }
    ],
    "legends": [
      {
        "fill": "color",
        "symbolType": "circle"
      }
    ],
    "marks": [
      {
        "type": "group",
        "encode": {
          "enter": {
            "x": {
              "signal": "width / 2"
            },
            "y": {
              "signal": "height / 2"
            }
          }
        },
        "marks": [
          {
            "type": "group",
            "from": {
              "data": "rings"
            },
            "marks": [
              {
                "type": "line",
                "from": {
                  "data": "keys"
                },
                "encode": {
                  "update": {
                    "interpolate": {
                      "value": "linear-closed"
                    },
                    "x": {
                      "signal": "radius * (parent.lvl / 4) * cos(scale('angular', datum['{{metric}}']))"
                    },
                    "y": {
                      "signal": "radius * (parent.lvl / 4) * sin(scale('angular', datum['{{metric}}']))"
                    },
                    "stroke": {
                      "value": "rgba(139, 148, 158, 0.35)"
                    },
                    "strokeWidth": {
                      "value": 1
                    },
                    "fill": {
                      "value": "rgba(139, 148, 158, 0.045)"
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "rule",
            "from": {
              "data": "keys"
            },
            "encode": {
              "update": {
                "x": {
                  "value": 0
                },
                "y": {
                  "value": 0
                },
                "x2": {
                  "signal": "radius * cos(scale('angular', datum['{{metric}}']))"
                },
                "y2": {
                  "signal": "radius * sin(scale('angular', datum['{{metric}}']))"
                },
                "stroke": {
                  "value": "rgba(139, 148, 158, 0.35)"
                },
                "strokeWidth": {
                  "value": 1
                }
              }
            }
          },
          {
            "type": "group",
            "from": {
              "facet": {
                "data": "table",
                "name": "facet",
                "groupby": "__mx_series"
              }
            },
            "marks": [
              {
                "type": "line",
                "from": {
                  "data": "facet"
                },
                "encode": {
                  "update": {
                    "interpolate": {
                      "value": "linear-closed"
                    },
                    "x": {
                      "signal": "scale('radial', datum.__mx_value) * cos(scale('angular', datum['{{metric}}']))"
                    },
                    "y": {
                      "signal": "scale('radial', datum.__mx_value) * sin(scale('angular', datum['{{metric}}']))"
                    },
                    "stroke": {
                      "scale": "color",
                      "field": "__mx_series"
                    },
                    "strokeWidth": {
                      "value": 2
                    },
                    "fill": {
                      "scale": "color",
                      "field": "__mx_series"
                    },
                    "fillOpacity": {
                      "value": 0.15
                    }
                  }
                }
              },
              {
                "type": "symbol",
                "from": {
                  "data": "facet"
                },
                "encode": {
                  "update": {
                    "x": {
                      "signal": "scale('radial', datum.__mx_value) * cos(scale('angular', datum['{{metric}}']))"
                    },
                    "y": {
                      "signal": "scale('radial', datum.__mx_value) * sin(scale('angular', datum['{{metric}}']))"
                    },
                    "fill": {
                      "scale": "color",
                      "field": "__mx_series"
                    },
                    "size": {
                      "value": 70
                    },
                    "tooltip": {
                      "signal": "{'Metric': datum['{{metric}}'], 'Series': datum.__mx_series, 'Value': format(datum.__mx_value, '.3~s')}"
                    }
                  }
                }
              },
              {
                "type": "symbol",
                "from": {
                  "data": "facet"
                },
                "encode": {
                  "update": {
                    "x": {
                      "signal": "scale('radial', datum.__mx_value) * cos(scale('angular', datum['{{metric}}']))"
                    },
                    "y": {
                      "signal": "scale('radial', datum.__mx_value) * sin(scale('angular', datum['{{metric}}']))"
                    },
                    "fill": {
                      "scale": "color",
                      "field": "__mx_series"
                    },
                    "fillOpacity": {
                      "value": 0.001
                    },
                    "size": {
                      "value": 900
                    },
                    "tooltip": {
                      "signal": "{'Metric': datum['{{metric}}'], 'Series': datum.__mx_series, 'Value': format(datum.__mx_value, '.3~s')}"
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "text",
            "from": {
              "data": "keys"
            },
            "encode": {
              "update": {
                "x": {
                  "signal": "(radius + 12) * cos(scale('angular', datum['{{metric}}']))"
                },
                "y": {
                  "signal": "(radius + 12) * sin(scale('angular', datum['{{metric}}']))"
                },
                "text": {
                  "field": "{{metric}}"
                },
                "align": {
                  "signal": "cos(scale('angular', datum['{{metric}}'])) > 0.05 ? 'left' : (cos(scale('angular', datum['{{metric}}'])) < -0.05 ? 'right' : 'center')"
                },
                "baseline": {
                  "signal": "sin(scale('angular', datum['{{metric}}'])) > 0.05 ? 'top' : (sin(scale('angular', datum['{{metric}}'])) < -0.05 ? 'bottom' : 'middle')"
                }
              }
            }
          }
        ]
      }
    ]
  }
}
