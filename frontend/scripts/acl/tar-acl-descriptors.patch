+/* Pin the object before ACL operations.  The parent directory is already
+   pinned by fdbase; never resolve its basename again after opening it.
+   Creation may intentionally dereference a source link, but the resulting
+   object must match the stat information used for the archive header.  */
+static int
+tar_acl_open_fd (int parentfd, char const *base, bool follow,
+                 struct stat const *expected)
+{
+  int fd = openat (parentfd, base,
+                   O_PATH | O_CLOEXEC | (follow ? 0 : O_NOFOLLOW));
+  if (fd < 0)
+    return -1;
+  struct stat actual;
+  int err = 0;
+  if (fstat (fd, &actual) != 0)
+    err = errno;
+  else if (S_ISLNK (actual.st_mode))
+    err = ENOTSUP;
+  else if (expected && (actual.st_dev != expected->st_dev
+                        || actual.st_ino != expected->st_ino))
+    err = ESTALE;
+  if (err)
+    {
+      close (fd);
+      errno = err;
+      return -1;
+    }
+  return fd;
+}
 
